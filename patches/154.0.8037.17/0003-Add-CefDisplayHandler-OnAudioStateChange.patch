Subject: Add CefDisplayHandler::OnAudioStateChange

Notify the client when a browser starts or stops producing audible
sound, as reported by WebContentsObserver::OnAudioStateChanged. A
client can then show a tab audio indicator without capturing the
audio stream through CefAudioHandler.

Assisted-by: Claude Code (Claude Opus 5.5)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>


diff --git a/include/cef_display_handler.h b/include/cef_display_handler.h
index 5ba804967..e64b159f5 100644
--- a/include/cef_display_handler.h
+++ b/include/cef_display_handler.h
@@ -203,6 +203,19 @@ class CefDisplayHandler : public virtual CefBaseRefCounted {
     return false;
   }
 #endif
+
+#if CEF_API_ADDED(CEF_EXPERIMENTAL)
+  ///
+  /// Called when the browser starts or stops producing audible sound.
+  /// |audible| is true while the browser produces sound, including while its
+  /// audio is muted with CefBrowserHost::SetAudioMuted. It turns false at the
+  /// first silence of playing media; clients that show a tab audio indicator
+  /// may keep it on for a short while (Chrome holds it for 2 seconds).
+  ///
+  /*--cef(added=experimental)--*/
+  virtual void OnAudioStateChange(CefRefPtr<CefBrowser> browser, bool audible) {
+  }
+#endif
 };
 
 #endif  // CEF_INCLUDE_CEF_DISPLAY_HANDLER_H_
diff --git a/libcef/browser/browser_contents_delegate.cc b/libcef/browser/browser_contents_delegate.cc
index b1591e91d..b5893e9c4 100644
--- a/libcef/browser/browser_contents_delegate.cc
+++ b/libcef/browser/browser_contents_delegate.cc
@@ -618,6 +618,14 @@ void CefBrowserContentsDelegate::TitleWasSet(content::NavigationEntry* entry) {
   }
 }
 
+void CefBrowserContentsDelegate::OnAudioStateChanged(bool audible) {
+  if (auto c = client()) {
+    if (auto handler = c->GetDisplayHandler()) {
+      handler->OnAudioStateChange(browser(), audible);
+    }
+  }
+}
